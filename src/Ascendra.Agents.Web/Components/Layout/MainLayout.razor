@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject DashboardSession Session
@inject ExcelSnapshotStore SnapshotStore
@inject NavigationManager Navigation
@inject OperationalAssetUrls AssetUrls
@inject IJSRuntime JS
@inject EphemeralChatService Chat

<AuthorizeView Context="auth">
    <Authorized>
        @{ Session.Apply(auth.User); }
        <div class="app-shell @ThemeClass @(Session.HasFullAccess ? "app-shell--team" : string.Empty)" style="@BackgroundAssetVariables" @onclick="CloseFloatingPanels">
            <main class="page-content">
                <header class="brand-card glass-card">
                    <div class="brand-block">
                        <div class="brand-logo-frame" aria-hidden="true"><img src="@AssetUrls.Url("xolo-wolf.png")" alt="" /></div>
                        <div>
                            <p class="brand-name">Ascendra</p>
                            <p class="brand-greeting">@Session.Greeting</p>
                        </div>
                    </div>
                    <div class="header-actions">
                        <div class="chat-control" @onclick:stopPropagation="true">
                            <button type="button" class="chat-button" @onclick="ToggleChatPanel" aria-expanded="@IsChatOpen" aria-controls="ascendra-chat-panel">
                                <span class="chat-button__mark" aria-hidden="true">◌</span>
                                Chat
                                @if (UnreadChatCount > 0)
                                {
                                    <span class="chat-button__badge" aria-label="@($"{UnreadChatCount} mensaje(s) nuevo(s)")">@UnreadChatCount</span>
                                }
                            </button>
                            @if (IsChatOpen)
                            {
                                <aside id="ascendra-chat-panel" class="chat-panel glass-card" aria-label="Chat de Ascendra">
                                    <header class="chat-panel__header">
                                        <div>
                                            <p class="eyebrow">EN LÍNEA</p>
                                            <h2>Chat</h2>
                                            <span>Los mensajes se eliminan en 7 días.</span>
                                        </div>
                                        <span class="chat-panel__presence">@OnlineChatUsers.Count conectados</span>
                                    </header>

                                    <div class="chat-mode" role="tablist" aria-label="Tipo de conversación">
                                        <button type="button" class="@ChatModeClass(ChatMode.General)" role="tab" aria-selected="@(CurrentChatMode == ChatMode.General)" @onclick="() => SelectChatMode(ChatMode.General)">
                                            General
                                            @if (UnreadGeneralCount > 0)
                                            {
                                                <span class="chat-mode__badge">@UnreadGeneralCount</span>
                                            }
                                        </button>
                                        <button type="button" class="@ChatModeClass(ChatMode.Private)" role="tab" aria-selected="@(CurrentChatMode == ChatMode.Private)" @onclick="() => SelectChatMode(ChatMode.Private)">
                                            Privado
                                            @if (UnreadPrivateCount > 0)
                                            {
                                                <span class="chat-mode__badge">@UnreadPrivateCount</span>
                                            }
                                        </button>
                                    </div>

                                    @if (CurrentChatMode == ChatMode.Private)
                                    {
                                        @if (CanReviewPrivateMessages)
                                        {
                                            <p class="chat-review-note">@ChatReviewNote</p>
                                        }
                                        <label class="chat-recipient">
                                            <span>@(CanReviewPrivateMessages ? "Enviar privado a" : "Conversación con")</span>
                                            <select @bind="SelectedChatRecipient" @bind:after="MarkVisibleChatMessagesRead" aria-label="Usuario conectado">
                                                <option value="">Selecciona un usuario conectado</option>
                                                @foreach (var user in PrivateConversationRecipients)
                                                {
                                                    <option value="@user.Username">@user.DisplayName@(IsOnline(user) ? string.Empty : " · desconectado")</option>
                                                }
                                            </select>
                                        </label>
                                    }

                                    <div class="chat-thread" aria-live="polite">
                                        @if (VisibleChatMessages.Count == 0)
                                        {
                                            <p class="chat-thread__empty">@(CurrentChatMode == ChatMode.General ? "Aún no hay mensajes. Saluda al equipo." : CanReviewPrivateMessages ? "Aún no hay mensajes privados internos." : "Selecciona un usuario para ver y enviar mensajes privados.")</p>
                                        }
                                        else
                                        {
                                            @foreach (var message in VisibleChatMessages)
                                            {
                                                <article class="chat-message @(IsOwnMessage(message) ? "chat-message--own" : null)">
                                                    <div class="chat-message__meta">
                                                        <strong>@(IsOwnMessage(message) ? "Tú" : message.Sender.DisplayName)</strong>
                                                        @if (message.Recipient is not null)
                                                        {
                                                            <span>para @RecipientLabel(message)</span>
                                                        }
                                                        <time datetime="@message.SentAt.ToString("O")">@message.SentAt.ToLocalTime().ToString("HH:mm")</time>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(message.Content))
                                                    {
                                                        <p>@message.Content</p>
                                                    }
                                                    @if (message.Attachment is not null)
                                                    {
                                                        <a class="chat-message__image" href="@($"/chat/attachments/{message.Attachment.Id}")" target="_blank" rel="noopener"><img src="@($"/chat/attachments/{message.Attachment.Id}")" alt="Imagen adjunta por @message.Sender.DisplayName" /></a>
                                                    }
                                                </article>
                                            }
                                        }
                                    </div>

                                    <form class="chat-composer" @onsubmit="SendChatMessageAsync" @onsubmit:preventDefault="true">
                                        <textarea @bind="ChatDraft" maxlength="500" rows="3" placeholder="Escribe un mensaje…" aria-label="Mensaje"></textarea>
                                        @if (PendingChatAttachment is not null)
                                        {
                                            <div class="chat-composer__attachment">
                                                <img src="@ChatAttachmentUrl(PendingChatAttachment)" alt="Imagen lista para enviar" />
                                                <span>@PendingChatAttachment.FileName</span>
                                                <button type="button" @onclick="RemoveChatAttachment">Quitar</button>
                                            </div>
                                        }
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(ChatError))
                                            {
                                                <span class="chat-composer__error" role="status">@ChatError</span>
                                            }
                                            <div class="chat-composer__actions">
                                                <button type="button" class="chat-emoji-button" @onclick="ToggleChatEmojiPicker" aria-label="Insertar emoji" aria-expanded="@IsChatEmojiPickerOpen">☺</button>
                                                @if (IsChatEmojiPickerOpen)
                                                {
                                                    <div class="chat-emoji-picker" role="group" aria-label="Emojis para insertar">
                                                        @foreach (var emoji in ChatEmojis)
                                                        {
                                                            <button type="button" title="@emoji.Label" aria-label="@emoji.Label" @onclick="() => AddChatEmoji(emoji.Value)">@emoji.Value</button>
                                                        }
                                                    </div>
                                                }
                                                <label class="chat-attach-button" title="Adjuntar imagen (máximo 4 MB)">
                                                    <span aria-hidden="true">▧</span> Imagen
                                                    <InputFile @key="ChatAttachmentInputKey" OnChange="SelectChatImageAsync" accept="image/png,image/jpeg,image/gif,image/webp" aria-label="Adjuntar imagen" />
                                                </label>
                                                <button type="submit" class="chat-send-button" disabled="@(CurrentChatMode == ChatMode.Private && !CanSendPrivateMessage)">Enviar</button>
                                            </div>
                                        </div>
                                    </form>
                                </aside>
                            }
                        </div>
                        <div class="appearance-control" @onclick:stopPropagation="true">
                            <button type="button" class="theme-button appearance-trigger" @onclick="ToggleAppearanceMenu" aria-haspopup="menu" aria-expanded="@IsAppearanceMenuOpen">
                                <span class="appearance-trigger__glow" aria-hidden="true"></span>
                                Apariencia
                                <span class="appearance-trigger__chevron" aria-hidden="true">⌄</span>
                            </button>
                            @if (IsAppearanceMenuOpen)
                            {
                                <div class="appearance-menu glass-card" role="menu" aria-label="Selecciona una apariencia">
                                    <button type="button" class="@AppearanceOptionClass(AppearanceMode.Light)" role="menuitemradio" aria-checked="@(Appearance == AppearanceMode.Light)" @onclick="() => SelectAppearance(AppearanceMode.Light)">
                                        <span class="appearance-swatch appearance-swatch--light" aria-hidden="true"></span>
                                        <span><strong>Claro</strong><small>Vidrio luminoso</small></span>
                                        <span class="appearance-check" aria-hidden="true">✓</span>
                                    </button>
                                    <button type="button" class="@AppearanceOptionClass(AppearanceMode.Dark)" role="menuitemradio" aria-checked="@(Appearance == AppearanceMode.Dark)" @onclick="() => SelectAppearance(AppearanceMode.Dark)">
                                        <span class="appearance-swatch appearance-swatch--dark" aria-hidden="true"></span>
                                        <span><strong>Oscuro</strong><small>Vidrio nocturno</small></span>
                                        <span class="appearance-check" aria-hidden="true">✓</span>
                                    </button>
                                    <button type="button" class="@AppearanceOptionClass(AppearanceMode.Pink)" role="menuitemradio" aria-checked="@(Appearance == AppearanceMode.Pink)" @onclick="() => SelectAppearance(AppearanceMode.Pink)">
                                        <span class="appearance-swatch appearance-swatch--pink" aria-hidden="true"></span>
                                        <span><strong>Pink</strong><small>Vidrio editorial</small></span>
                                        <span class="appearance-check" aria-hidden="true">✓</span>
                                    </button>
                                    <button type="button" class="@AppearanceOptionClass(AppearanceMode.Sierra)" role="menuitemradio" aria-checked="@(Appearance == AppearanceMode.Sierra)" @onclick="() => SelectAppearance(AppearanceMode.Sierra)">
                                        <span class="appearance-swatch appearance-swatch--sierra" aria-hidden="true"></span>
                                        <span><strong>Sierra</strong><small>Vidrio mineral</small></span>
                                        <span class="appearance-check" aria-hidden="true">✓</span>
                                    </button>
                                    <button type="button" class="@AppearanceOptionClass(AppearanceMode.Aurora)" role="menuitemradio" aria-checked="@(Appearance == AppearanceMode.Aurora)" @onclick="() => SelectAppearance(AppearanceMode.Aurora)">
                                        <span class="appearance-swatch appearance-swatch--aurora" aria-hidden="true"></span>
                                        <span><strong>Aurora</strong><small>Vidrio polar</small></span>
                                        <span class="appearance-check" aria-hidden="true">✓</span>
                                    </button>
                                    <button type="button" class="@AppearanceOptionClass(AppearanceMode.Oceano)" role="menuitemradio" aria-checked="@(Appearance == AppearanceMode.Oceano)" @onclick="() => SelectAppearance(AppearanceMode.Oceano)">
                                        <span class="appearance-swatch appearance-swatch--oceano" aria-hidden="true"></span>
                                        <span><strong>Océano</strong><small>Vidrio abisal</small></span>
                                        <span class="appearance-check" aria-hidden="true">✓</span>
                                    </button>
                                    <button type="button" class="@AppearanceOptionClass(AppearanceMode.Ambar)" role="menuitemradio" aria-checked="@(Appearance == AppearanceMode.Ambar)" @onclick="() => SelectAppearance(AppearanceMode.Ambar)">
                                        <span class="appearance-swatch appearance-swatch--ambar" aria-hidden="true"></span>
                                        <span><strong>Ámbar</strong><small>Vidrio ejecutivo</small></span>
                                        <span class="appearance-check" aria-hidden="true">✓</span>
                                    </button>
                                </div>
                            }
                        </div>
                        <form method="post" action="/account/logout">
                            <AntiforgeryToken />
                            <button class="logout-button" type="submit">Cerrar sesión</button>
                        </form>
                    </div>
                </header>

                <nav class="main-tabs glass-card" aria-label="Módulos principales">
                    <NavLink href="/referencias" class="nav-tab">Referencias</NavLink>
                    @if (!Session.HasFullAccess)
                    {
                        <NavLink href="/whatsapp" class="nav-tab">WhatsApp</NavLink>
                    }
                    @if (Session.HasFullAccess)
                    {
                        <NavLink href="/equipo" class="nav-tab">Equipo</NavLink>
                    }
                    else
                    {
                        <NavLink href="/" Match="NavLinkMatch.All" class="nav-tab">Mi recuperación</NavLink>
                        <NavLink href="/promesas" class="nav-tab">Mis promesas</NavLink>
                    }
                </nav>

                @if (!SnapshotStore.Health.IsReady)
                {
                    <aside class="data-warning glass-card" role="status">
                        <strong>Corte pendiente</strong>
                        <span>@SnapshotStore.Health.Message</span>
                    </aside>
                }

                @Body
            </main>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private AppearanceMode Appearance { get; set; } = AppearanceMode.Light;
    private bool IsAppearanceMenuOpen { get; set; }
    private bool RefreshChartsAfterRender { get; set; }
    private readonly string ChatConnectionId = Guid.NewGuid().ToString("N");
    private ChatParticipant? ChatParticipant { get; set; }
    private ChatPanelState ChatState { get; set; } = ChatPanelState.Empty;
    private bool IsChatOpen { get; set; }
    private bool ChatRegistered { get; set; }
    private bool IsDisposed { get; set; }
    private readonly HashSet<Guid> ReadChatMessageIds = [];
    private ChatMode CurrentChatMode { get; set; } = ChatMode.General;
    private string SelectedChatRecipient { get; set; } = string.Empty;
    private string ChatDraft { get; set; } = string.Empty;
    private bool IsChatEmojiPickerOpen { get; set; }
    private ChatAttachment? PendingChatAttachment { get; set; }
    private Guid ChatAttachmentInputKey { get; set; } = Guid.NewGuid();
    private string? ChatError { get; set; }
    private static readonly (string Value, string Label)[] ChatEmojis =
    [
        ("👀", "Revisar"), ("✅", "Confirmado"), ("❤️", "Me gusta"), ("💵", "Pago"), ("🤑", "Cobrado"), ("💯", "Cien por ciento"),
        ("😊", "Sonrisa"), ("🙂", "De acuerdo"), ("🙃", "Ironía"), ("😎", "Excelente"), ("🤓", "Detalle"), ("😍", "Me encanta"),
        ("😤", "Esfuerzo"), ("😡", "Molesto"), ("🥶", "Urgente"), ("😶‍🌫️", "Sin palabras"), ("😱", "Sorpresa"), ("🫠", "Complicado"),
        ("🫪", "Cara distorsionada"), ("💩", "Problema"), ("🙌🏻", "Celebración"), ("👏🏻", "Aplausos"), ("🫡", "Entendido"), ("😐", "Neutral"),
        ("🎄", "Navidad"), ("🎁", "Regalo"), ("🎂", "Cumpleaños"), ("🥳", "Fiesta"), ("👍", "Pulgar arriba"), ("🙏", "Gracias"),
        ("📌", "Importante"), ("⚠️", "Atención"), ("⏱️", "Pendiente"), ("🎯", "Objetivo"), ("🚨", "Alerta"), ("📎", "Adjunto"),
    ];
    // Durante el prerenderizado todavía no existe un navegador conectado. Sólo
    // intentamos detener el temporizador si realmente llegó a iniciarse en el
    // cliente interactivo.
    private bool SessionTrackingStarted { get; set; }
    private string ThemeClass => Appearance switch
    {
        AppearanceMode.Dark => "theme-dark",
        AppearanceMode.Pink => "theme-pink",
        AppearanceMode.Sierra => "theme-sierra",
        AppearanceMode.Aurora => "theme-aurora",
        AppearanceMode.Oceano => "theme-oceano",
        AppearanceMode.Ambar => "theme-ambar",
        _ => "theme-light",
    };
    private string BackgroundAssetVariables => $"--ascendra-day-background: url('{AssetUrls.Url("leaves-day-bg.jpg")}'); --ascendra-night-background: url('{AssetUrls.Url("galaxy-bg.jpg")}'); --ascendra-pink-background: url('{AssetUrls.Url("pink-bg.jpg")}'); --ascendra-rock-background: url('{AssetUrls.Url("rock-bg.jpg")}'); --ascendra-aurora-background: url('{AssetUrls.Url("aurora-bg.jpg")}'); --ascendra-oceano-background: url('{AssetUrls.Url("oceano-bg.jpg")}'); --ascendra-ambar-background: url('{AssetUrls.Url("ambar.jpg")}');";

    private void ToggleAppearanceMenu()
    {
        IsAppearanceMenuOpen = !IsAppearanceMenuOpen;
        if (IsAppearanceMenuOpen) IsChatOpen = false;
    }
    private void SelectAppearance(AppearanceMode appearance)
    {
        var changed = Appearance != appearance;
        Appearance = appearance;
        IsAppearanceMenuOpen = false;
        if (changed) RefreshChartsAfterRender = true;
    }
    private string AppearanceOptionClass(AppearanceMode appearance) =>
        Appearance == appearance ? "appearance-option appearance-option--selected" : "appearance-option";

    private IReadOnlyList<ChatParticipant> OnlineChatUsers => ChatState.ConnectedUsers;
    private IReadOnlyList<ChatParticipant> AvailableDirectRecipients =>
        ChatParticipant is null
            ? Array.Empty<ChatParticipant>()
            : ChatState.ConnectedUsers
                .Where(user => !string.Equals(user.Username, ChatParticipant.Username, StringComparison.OrdinalIgnoreCase))
                .ToArray();
    private bool CanReviewPrivateMessages => ChatParticipant?.CanReviewPrivateMessages == true;
    private string ChatReviewNote => ChatParticipant?.Role switch
    {
        ChatUserRole.Manager => "Vista gerencial: puedes consultar la comunicación interna, excepto los mensajes enviados por otros gerentes.",
        ChatUserRole.Supervisor => "Vista de supervisión: puedes consultar las conversaciones internas entre agentes de los últimos 7 días.",
        _ => string.Empty,
    };
    private IReadOnlyList<ChatParticipant> PrivateConversationRecipients =>
        CanReviewPrivateMessages
            ? AvailableDirectRecipients
            : AvailableDirectRecipients
            .Concat(ChatState.Messages
                .Where(message => message.Recipient is not null && (IsOwnMessage(message)
                    || string.Equals(message.Recipient.Username, ChatParticipant?.Username, StringComparison.OrdinalIgnoreCase)))
                .Select(message => IsOwnMessage(message) ? message.Recipient! : message.Sender))
            .GroupBy(user => user.Username, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .OrderBy(user => user.DisplayName, StringComparer.CurrentCultureIgnoreCase)
            .ToArray();
    private IReadOnlyList<ChatMessage> VisibleChatMessages => CurrentChatMode == ChatMode.General
        ? ChatState.Messages.Where(message => message.Recipient is null).ToArray()
        : CanReviewPrivateMessages
            ? ChatState.Messages.Where(message => message.Recipient is not null).ToArray()
        : string.IsNullOrWhiteSpace(SelectedChatRecipient)
            ? Array.Empty<ChatMessage>()
            : ChatState.Messages.Where(message => message.Recipient is not null
                && ((string.Equals(message.Sender.Username, ChatParticipant?.Username, StringComparison.OrdinalIgnoreCase)
                        && string.Equals(message.Recipient.Username, SelectedChatRecipient, StringComparison.OrdinalIgnoreCase))
                    || (string.Equals(message.Sender.Username, SelectedChatRecipient, StringComparison.OrdinalIgnoreCase)
                        && string.Equals(message.Recipient.Username, ChatParticipant?.Username, StringComparison.OrdinalIgnoreCase))))
                .ToArray();
    private IReadOnlyList<ChatMessage> UnreadIncomingMessages => ChatState.Messages
        .Where(message => !IsOwnMessage(message) && !ReadChatMessageIds.Contains(message.Id))
        .ToArray();
    private int UnreadChatCount => UnreadIncomingMessages.Count;
    private int UnreadGeneralCount => UnreadIncomingMessages.Count(message => message.Recipient is null);
    private int UnreadPrivateCount => UnreadIncomingMessages.Count(message => message.Recipient is not null);
    private bool CanSendPrivateMessage => AvailableDirectRecipients.Any(user =>
        string.Equals(user.Username, SelectedChatRecipient, StringComparison.OrdinalIgnoreCase));

    private void ToggleChatPanel()
    {
        IsChatOpen = !IsChatOpen;
        IsAppearanceMenuOpen = false;
        IsChatEmojiPickerOpen = false;
        ChatError = null;
        if (IsChatOpen)
        {
            FocusLatestPrivateMessage();
            MarkVisibleChatMessagesRead();
        }
    }

    private void CloseFloatingPanels()
    {
        IsChatOpen = false;
        IsAppearanceMenuOpen = false;
        IsChatEmojiPickerOpen = false;
    }

    private void SelectChatMode(ChatMode mode)
    {
        CurrentChatMode = mode;
        ChatError = null;
        IsChatEmojiPickerOpen = false;
        if (mode == ChatMode.Private && string.IsNullOrWhiteSpace(SelectedChatRecipient))
        {
            FocusLatestPrivateMessage();
            if (string.IsNullOrWhiteSpace(SelectedChatRecipient))
            {
                SelectedChatRecipient = AvailableDirectRecipients.FirstOrDefault()?.Username ?? string.Empty;
            }
        }
        MarkVisibleChatMessagesRead();
    }

    private string ChatModeClass(ChatMode mode) =>
        CurrentChatMode == mode ? "chat-mode__option chat-mode__option--selected" : "chat-mode__option";

    private bool IsOwnMessage(ChatMessage message) => ChatParticipant is not null
        && string.Equals(message.Sender.Username, ChatParticipant.Username, StringComparison.OrdinalIgnoreCase);

    private string RecipientLabel(ChatMessage message) =>
        message.Recipient is null
            ? string.Empty
            : IsOwnMessage(message) || CanReviewPrivateMessages
                ? message.Recipient.DisplayName
                : "ti";

    private void ToggleChatEmojiPicker() => IsChatEmojiPickerOpen = !IsChatEmojiPickerOpen;

    private void AddChatEmoji(string emoji)
    {
        if (ChatDraft.Length + emoji.Length <= 500) ChatDraft += emoji;
        IsChatEmojiPickerOpen = false;
    }

    private async Task SendChatMessageAsync()
    {
        if (ChatParticipant is null) return;

        try
        {
            if (CurrentChatMode == ChatMode.General)
            {
                Chat.SendToEveryone(ChatParticipant, ChatDraft, PendingChatAttachment);
            }
            else
            {
                Chat.SendPrivate(ChatParticipant, SelectedChatRecipient, ChatDraft, PendingChatAttachment);
            }

            ChatDraft = string.Empty;
            IsChatEmojiPickerOpen = false;
            PendingChatAttachment = null;
            ChatAttachmentInputKey = Guid.NewGuid();
            ChatError = null;
            MarkVisibleChatMessagesRead();
        }
        catch (InvalidOperationException exception)
        {
            ChatError = exception.Message;
            if (exception.Message.Contains("imagen", StringComparison.OrdinalIgnoreCase))
            {
                PendingChatAttachment = null;
                ChatAttachmentInputKey = Guid.NewGuid();
            }
        }
    }

    private async Task SelectChatImageAsync(InputFileChangeEventArgs arguments)
    {
        if (ChatParticipant is null) return;
        try
        {
            if (PendingChatAttachment is not null) Chat.DiscardStagedAttachment(ChatParticipant, PendingChatAttachment);
            var file = arguments.File;
            await using var stream = file.OpenReadStream(EphemeralChatService.MaximumImageBytes);
            PendingChatAttachment = await Chat.StoreImageAsync(ChatParticipant, stream, file.Name);
            ChatError = null;
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException)
        {
            PendingChatAttachment = null;
            ChatAttachmentInputKey = Guid.NewGuid();
            ChatError = exception is InvalidOperationException
                ? exception.Message
                : "No se pudo adjuntar la imagen. Usa un archivo de hasta 4 MB.";
        }
    }

    private void RemoveChatAttachment()
    {
        if (ChatParticipant is not null) Chat.DiscardStagedAttachment(ChatParticipant, PendingChatAttachment);
        PendingChatAttachment = null;
        ChatAttachmentInputKey = Guid.NewGuid();
    }

    private static string ChatAttachmentUrl(ChatAttachment attachment) => $"/chat/attachments/{attachment.Id}";

    private async Task StartChatAsync()
    {
        if (ChatRegistered || Session.User is null) return;

        ChatParticipant = EphemeralChatService.ParticipantFor(Session.User);
        var hasPersistedReadState = await RestoreReadChatMessagesAsync();
        Chat.Changed += OnChatChanged;
        ChatRegistered = true;
        Chat.Register(ChatConnectionId, ChatParticipant);
        ChatState = Chat.GetState(ChatParticipant);
        if (!hasPersistedReadState)
        {
            ReadChatMessageIds.UnionWith(ChatState.Messages.Select(message => message.Id));
        }
        await PersistReadChatMessagesAsync();
    }

    private void OnChatChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (IsDisposed || !ChatRegistered || ChatParticipant is null) return;

            ChatState = Chat.GetState(ChatParticipant);
            if (CurrentChatMode == ChatMode.Private && !string.IsNullOrWhiteSpace(SelectedChatRecipient)
                && !PrivateConversationRecipients.Any(user => string.Equals(user.Username, SelectedChatRecipient, StringComparison.OrdinalIgnoreCase)))
            {
                SelectedChatRecipient = string.Empty;
            }

            if (IsChatOpen)
            {
                MarkVisibleChatMessagesRead();
            }

            StateHasChanged();
        });
    }

    private void MarkVisibleChatMessagesRead()
    {
        if (!IsChatOpen) return;
        var readAnyMessage = false;
        foreach (var message in VisibleChatMessages)
        {
            readAnyMessage |= ReadChatMessageIds.Add(message.Id);
        }
        if (readAnyMessage) _ = PersistReadChatMessagesAsync();
    }

    private async Task<bool> RestoreReadChatMessagesAsync()
    {
        if (ChatParticipant is null) return false;
        try
        {
            var saved = await JS.InvokeAsync<PersistedChatReadState>("ascendraChatRead.load", ChatParticipant.Username);
            if (saved is null || !saved.HasState) return false;

            foreach (var id in saved.Ids)
            {
                if (Guid.TryParse(id, out var messageId)) ReadChatMessageIds.Add(messageId);
            }
            return true;
        }
        catch (JSDisconnectedException)
        {
            return false;
        }
        catch (InvalidOperationException)
        {
            return false;
        }
    }

    private async Task PersistReadChatMessagesAsync()
    {
        if (ChatParticipant is null || IsDisposed) return;
        try
        {
            await JS.InvokeVoidAsync("ascendraChatRead.save", ChatParticipant.Username,
                ReadChatMessageIds.Select(id => id.ToString("D")).Take(8000).ToArray());
        }
        catch (JSDisconnectedException)
        {
            // El navegador ya cerró la vista; el estado visible se conserva localmente.
        }
        catch (InvalidOperationException)
        {
            // El circuito puede terminar durante una navegación o actualización.
        }
    }

    private void FocusLatestPrivateMessage()
    {
        var latest = UnreadIncomingMessages
            .Where(message => message.Recipient is not null)
            .OrderByDescending(message => message.SentAt)
            .FirstOrDefault()
            ?? ChatState.Messages
                .Where(message => message.Recipient is not null)
                .OrderByDescending(message => message.SentAt)
                .FirstOrDefault();
        if (latest is null) return;

        CurrentChatMode = ChatMode.Private;
        SelectedChatRecipient = IsOwnMessage(latest)
            ? latest.Recipient!.Username
            : latest.Sender.Username;
    }

    private bool IsOnline(ChatParticipant user) => OnlineChatUsers.Any(online =>
        string.Equals(online.Username, user.Username, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("ascendraSession.start");
            SessionTrackingStarted = true;
            if (!Session.HasFullAccess) await StartChatAsync();
        }

        if (!RefreshChartsAfterRender) return;
        RefreshChartsAfterRender = false;
        await JS.InvokeVoidAsync("ascendraCharts.refreshTheme");
    }

    public async ValueTask DisposeAsync()
    {
        IsDisposed = true;
        RemoveChatAttachment();
        if (ChatRegistered)
        {
            Chat.Changed -= OnChatChanged;
            Chat.Unregister(ChatConnectionId);
            ChatRegistered = false;
        }

        if (!SessionTrackingStarted) return;

        try
        {
            await JS.InvokeVoidAsync("ascendraSession.stop");
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            // El circuito ya terminó; no queda ningún temporizador que cancelar.
        }
    }

    private sealed record PersistedChatReadState(bool HasState, string[] Ids);

    private enum AppearanceMode { Light, Dark, Pink, Sierra, Aurora, Oceano, Ambar }
    private enum ChatMode { General, Private }
}
