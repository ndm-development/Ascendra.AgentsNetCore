@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var destination = string.IsNullOrWhiteSpace(relative) ? "/" : "/" + relative;
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(destination)}", forceLoad: true);
    }
}
