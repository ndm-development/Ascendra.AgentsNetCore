<div class="glass-select @(IsOpen ? "glass-select--open" : null) @(Disabled ? "glass-select--disabled" : null)" @onclick:stopPropagation="true">
    <button id="@Id"
            type="button"
            class="glass-select__trigger"
            role="combobox"
            aria-controls="@MenuId"
            aria-expanded="@IsOpen"
            aria-haspopup="listbox"
            disabled="@Disabled"
            @onclick="Toggle">
        <span class="glass-select__value @(SelectedOption is null ? "glass-select__value--placeholder" : null)">@DisplayText</span>
        <span class="glass-select__chevron" aria-hidden="true">⌄</span>
    </button>

    @if (IsOpen && !Disabled)
    {
        @if (HasSubmenus)
        {
            <div id="@MenuId" class="glass-select__menu glass-select__menu--nested" role="listbox" aria-label="@MenuLabel">
                <div class="glass-select__categories" aria-label="Categorías de tipificación">
                    @foreach (var group in Groups)
                    {
                        var isActive = string.Equals(ActiveGroup, group.Key, StringComparison.Ordinal);
                        <button type="button"
                                class="glass-select__category @(isActive ? "glass-select__category--active" : null)"
                                aria-current="@isActive"
                                @onmouseenter="() => ActivateGroup(group.Key)"
                                @onfocus="() => ActivateGroup(group.Key)"
                                @onclick="() => ActivateGroup(group.Key)">
                            <span>@group.Key</span>
                            <span aria-hidden="true">›</span>
                        </button>
                    }
                </div>
                <div class="glass-select__submenu" aria-label="Resultados de @ActiveGroup">
                    <p>@ActiveGroup</p>
                    @foreach (var option in ActiveOptions)
                    {
                        <button type="button"
                                class="glass-select__option @(IsSelected(option) ? "glass-select__option--selected" : null)"
                                role="option"
                                aria-selected="@IsSelected(option)"
                                disabled="@option.Disabled"
                                @onclick="() => SelectAsync(option.Value)">
                            <span>@option.Label</span>
                            @if (IsSelected(option))
                            {
                                <span class="glass-select__check" aria-hidden="true">✓</span>
                            }
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <div id="@MenuId" class="glass-select__menu" role="listbox" aria-label="@MenuLabel">
                @foreach (var option in Options)
                {
                    <button type="button"
                            class="glass-select__option @(IsSelected(option) ? "glass-select__option--selected" : null)"
                            role="option"
                            aria-selected="@IsSelected(option)"
                            disabled="@option.Disabled"
                            @onclick="() => SelectAsync(option.Value)">
                        <span>@option.Label</span>
                        @if (IsSelected(option))
                        {
                            <span class="glass-select__check" aria-hidden="true">✓</span>
                        }
                    </button>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = $"glass-select-{Guid.NewGuid():N}";
    [Parameter] public string MenuLabel { get; set; } = "Opciones";
    [Parameter] public string Placeholder { get; set; } = "Selecciona una opción";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<GlassSelectOption> Options { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }

    private bool IsOpen { get; set; }
    private string? ActiveGroup { get; set; }

    private string MenuId => $"{Id}-options";
    private GlassSelectOption? SelectedOption => Options.FirstOrDefault(option => string.Equals(option.Value, Value, StringComparison.Ordinal));
    private string DisplayText => SelectedOption?.SelectedLabel ?? SelectedOption?.Label ?? Placeholder;
    private IReadOnlyList<IGrouping<string, GlassSelectOption>> Groups => Options
        .Where(option => !string.IsNullOrWhiteSpace(option.Group))
        .GroupBy(option => option.Group!, StringComparer.Ordinal)
        .ToArray();
    private bool HasSubmenus => Groups.Count > 0;
    private IEnumerable<GlassSelectOption> ActiveOptions => Options.Where(option => string.Equals(option.Group, ActiveGroup, StringComparison.Ordinal));

    private void Toggle()
    {
        if (Disabled)
        {
            return;
        }

        IsOpen = !IsOpen;
        if (IsOpen && HasSubmenus)
        {
            ActiveGroup = SelectedOption?.Group ?? Groups.FirstOrDefault()?.Key;
        }
    }

    private void ActivateGroup(string group) => ActiveGroup = group;

    private bool IsSelected(GlassSelectOption option) => string.Equals(Value, option.Value, StringComparison.Ordinal);

    private async Task SelectAsync(string value)
    {
        IsOpen = false;
        if (!string.Equals(Value, value, StringComparison.Ordinal))
        {
            await ValueChanged.InvokeAsync(value);
        }
    }
}
