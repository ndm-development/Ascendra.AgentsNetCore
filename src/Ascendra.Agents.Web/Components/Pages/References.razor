@page "/referencias"
@attribute [Authorize]
@using System.Security.Claims
@inject DashboardQueries Queries
@inject CallDispositionService Dispositions
@inject AuthenticationStateProvider AuthenticationStateProvider

<section class="lookup-shell glass-card">
    <div class="lookup-heading">
        <h1>Búsqueda clientes</h1>
    </div>
    <div class="lookup-controls">
        <div class="segmented-control" role="group" aria-label="Tipo de búsqueda">
            <button class="@(!ByPhone ? "" : "selected")" @onclick="() => SelectSearchMode(true)">Teléfono</button>
            <button class="@(ByPhone ? "" : "selected")" @onclick="() => SelectSearchMode(false)">CLIENTE_UNICO</button>
        </div>
        <input class="lookup-search-input" @bind="Query" @bind:event="oninput" inputmode="@(ByPhone ? "numeric" : "text")" placeholder="@(ByPhone ? "Escribe un número telefónico" : "Escribe un CLIENTE_UNICO")" aria-label="Consulta" />
        <button type="button" class="primary-button" @onclick="SearchAsync">Consultar</button>
        <button type="button" class="secondary-button" @onclick="Clear">Limpiar</button>
    </div>
</section>

@if (ShowDispositionPanel)
{
    var selectedHistory = HistoryFor(SelectedDispositionClientId);
    <section class="call-disposition glass-card" aria-label="Tipificación de llamada">
        <div class="call-disposition__heading">
            <div>
                <p class="eyebrow">DISPOSICIÓN DE LLAMADA</p>
                <h2>Registra el resultado de @SearchedPhone</h2>
                @if (PhoneCandidates.Count > 1)
                {
                    <p>Este número está asociado a más de un cliente. Elige a quién corresponde la gestión antes de registrarla.</p>
                }
            </div>
            <div class="call-disposition__highest">
                <span>Disposición de mayor peso</span>
                @if (selectedHistory.HighestWeight is { } highest)
                {
                    <strong>@highest.Category</strong>
                    <p>@highest.Result</p>
                }
                else if (PhoneCandidates.Count > 1 && string.IsNullOrWhiteSpace(SelectedDispositionClientId))
                {
                    <strong>Selecciona un cliente</strong>
                    <p>Mostraremos su disposición más relevante.</p>
                }
                else
                {
                    <strong>Sin tipificaciones</strong>
                    <p>Este cliente aún no tiene gestión registrada.</p>
                }
            </div>
        </div>

        <div class="call-disposition__controls">
            @if (PhoneCandidates.Count > 1)
            {
                <div class="field call-disposition__client">
                    <label for="disposition-client">CLIENTE_UNICO a tipificar</label>
                    <select id="disposition-client" @bind="SelectedDispositionClientId" @bind:after="OnDispositionClientChangedAsync">
                        <option value="">Selecciona un cliente</option>
                        @foreach (var candidate in PhoneCandidates)
                        {
                            <option value="@candidate.ClientId">@candidate.ClientId · @candidate.ClientName</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="call-disposition__client call-disposition__client--locked">
                    <span>CLIENTE_UNICO</span>
                    <strong>@SelectedDispositionClientId</strong>
                </div>
            }
            <div class="field">
                <label for="disposition-category">Categoría</label>
                <select id="disposition-category" @bind="SelectedCategory" @bind:after="ResetDispositionResult" disabled="@(!CanChooseDisposition)">
                    <option value="">Selecciona una categoría</option>
                    @foreach (var category in Dispositions.Categories)
                    {
                        <option value="@category.Name">@category.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="disposition-result">Resultado</label>
                <select id="disposition-result" @bind="SelectedResult" disabled="@string.IsNullOrWhiteSpace(SelectedCategory)">
                    <option value="">Selecciona un resultado</option>
                    @foreach (var outcome in Dispositions.ResultsFor(SelectedCategory))
                    {
                        <option value="@outcome">@outcome</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="disposition-channel">Canal</label>
                <select id="disposition-channel" @bind="SelectedChannel" disabled="@(!CanChooseDisposition)">
                    <option value="">Selecciona un canal</option>
                    @foreach (var channel in Dispositions.Channels)
                    {
                        <option value="@channel">@channel</option>
                    }
                </select>
            </div>
            <button type="button" class="primary-button call-disposition__save" @onclick="SaveDispositionAsync" disabled="@(!CanSaveDisposition || IsSavingDisposition)">
                @(IsSavingDisposition ? "Guardando…" : "Registrar tipificación")
            </button>
        </div>

        <div class="call-disposition__comment field">
            <label for="disposition-comment">Comentario opcional <span>@CommentWordCount/100 palabras</span></label>
            <textarea id="disposition-comment" rows="2" @bind="DispositionComment" @bind:event="oninput" placeholder="Agrega un contexto breve, si hace falta." aria-describedby="disposition-comment-limit"></textarea>
            <small id="disposition-comment-limit">Solo se mostrará junto con esta gestión.</small>
        </div>

        @if (!string.IsNullOrWhiteSpace(DispositionMessage))
        {
            <p class="lookup-notice @(DispositionSucceeded ? "lookup-notice--success" : "lookup-notice--error")" role="status">@DispositionMessage</p>
        }
    </section>
}

@if (Searched && Results.Count == 0)
{
    <section class="empty-state glass-card"><h2>Sin coincidencias</h2><p>Verifica el dato y confirma que el CRM generado corresponda al corte actual.</p></section>
}
else if (Results.Count > 0)
{
    @foreach (var group in ClientGroups)
    {
        var first = group.First();
        var contact = first.Contact;
        var history = HistoryFor(group.Key);
        <section class="reference-result glass-card">
            <div class="result-heading">
                <div><p class="eyebrow">CLIENTE_UNICO</p><h2>@group.Key</h2></div>
                <span class="status-badge @(contact.Status.Equals("Activo", StringComparison.OrdinalIgnoreCase) ? "status-active" : "")">@(string.IsNullOrWhiteSpace(contact.Status) ? "Sin estatus" : contact.Status)</span>
            </div>
            <dl class="client-facts">
                <div><dt>Nombre</dt><dd>@(string.IsNullOrWhiteSpace(contact.ClientName) ? "No disponible en cartera vigente" : contact.ClientName)</dd></div>
                <div><dt>Producto</dt><dd>@(string.IsNullOrWhiteSpace(contact.Product) ? "No disponible en cartera vigente" : contact.Product)</dd></div>
                <div><dt>Saldo total</dt><dd>@(contact.TotalBalance is null ? "No disponible" : DashboardQueries.Currency(contact.TotalBalance.Value))</dd></div>
                <div><dt>Última promesa · Agente</dt><dd>@(string.IsNullOrWhiteSpace(first.LatestPromiseAgent) ? "Sin promesa registrada" : first.LatestPromiseAgent)</dd></div>
                <div><dt>Última promesa · Estatus</dt><dd>@(string.IsNullOrWhiteSpace(first.LatestPromiseStatus) ? "—" : first.LatestPromiseStatus)</dd></div>
            </dl>
            <div class="table-wrap"><table><thead><tr><th>Teléfono</th><th>Referencia</th><th>Parentesco</th><th>Origen</th></tr></thead><tbody>
                @foreach (var row in group.OrderBy(x => x.Contact.Phone).ThenBy(x => x.Contact.ReferenceName))
                { <tr><td class="phone-cell">@row.Contact.Phone</td><td>@(string.IsNullOrWhiteSpace(row.Contact.ReferenceName) ? "—" : row.Contact.ReferenceName)</td><td>@(string.IsNullOrWhiteSpace(row.Contact.Relationship) ? "—" : row.Contact.Relationship)</td><td>@row.Contact.Source</td></tr> }
            </tbody></table></div>

            <section class="disposition-history" aria-label="Historial de tipificaciones de @group.Key">
                <div class="disposition-history__heading">
                    <div><p class="eyebrow">HISTORIAL DE TIPIFICACIONES</p><h3>Gestiones del cliente</h3></div>
                    @if (history.TotalEntries > 0)
                    {
                        <span>@(history.TotalEntries == history.Entries.Count ? $"{history.TotalEntries} registro{(history.TotalEntries == 1 ? string.Empty : "s")}" : $"Últimos {history.Entries.Count} de {history.TotalEntries}")</span>
                    }
                </div>
                @if (history.Entries.Count == 0)
                {
                    <p class="disposition-history__empty">Aún no hay tipificaciones para este cliente.</p>
                }
                else
                {
                    <div class="table-wrap disposition-history__table"><table><thead><tr><th>Fecha</th><th>ID agente</th><th>Agente</th><th>Tipificación</th><th>Canal</th><th>Teléfono</th></tr></thead><tbody>
                        @foreach (var entry in history.Entries)
                        {
                            <tr><td>@OperationalClock.Format(entry.RecordedAt, "dd/MM/yyyy · HH:mm")</td><td>@entry.AgentId</td><td>@entry.AgentName</td><td><strong>@entry.Category</strong><span class="disposition-history__result">@entry.Result</span>@if (!string.IsNullOrWhiteSpace(entry.Comment)) { <span class="disposition-history__comment">@entry.Comment</span> }</td><td class="disposition-history__channel">@entry.Channel</td><td class="phone-cell">@entry.Phone</td></tr>
                        }
                    </tbody></table></div>
                }
            </section>
        </section>
    }
}

@code {
    private bool ByPhone { get; set; } = true;
    private string Query { get; set; } = string.Empty;
    private bool Searched { get; set; }
    private IReadOnlyList<ReferenceLookupResult> Results { get; set; } = [];
    private IReadOnlyDictionary<string, ClientDispositionHistory> Histories { get; set; } = new Dictionary<string, ClientDispositionHistory>(StringComparer.OrdinalIgnoreCase);
    private string? SelectedDispositionClientId { get; set; }
    private string? SelectedCategory { get; set; }
    private string? SelectedResult { get; set; }
    private string? SelectedChannel { get; set; }
    private string DispositionComment { get; set; } = string.Empty;
    private string? DispositionMessage { get; set; }
    private bool DispositionSucceeded { get; set; }
    private bool IsSavingDisposition { get; set; }

    private IReadOnlyList<IGrouping<string, ReferenceLookupResult>> ClientGroups => Results
        .GroupBy(result => result.Contact.ClientId, StringComparer.OrdinalIgnoreCase)
        .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private IReadOnlyList<DispositionClientCandidate> PhoneCandidates => ClientGroups
        .Select(group =>
        {
            var contact = group.First().Contact;
            return new DispositionClientCandidate(
                group.Key,
                string.IsNullOrWhiteSpace(contact.ClientName) ? "Nombre no disponible" : contact.ClientName);
        })
        .ToArray();

    private string SearchedPhone => TextNormalization.Phone(Query);
    private bool ShowDispositionPanel => ByPhone && Searched && PhoneCandidates.Count > 0 && SearchedPhone.Length > 0;
    private bool CanChooseDisposition => !string.IsNullOrWhiteSpace(SelectedDispositionClientId);
    private bool CanSaveDisposition => CanChooseDisposition
        && !string.IsNullOrWhiteSpace(SelectedCategory)
        && !string.IsNullOrWhiteSpace(SelectedResult)
        && !string.IsNullOrWhiteSpace(SelectedChannel)
        && CommentWordCount <= 100;
    private int CommentWordCount => string.IsNullOrWhiteSpace(DispositionComment)
        ? 0
        : DispositionComment.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    private async Task SearchAsync()
    {
        Results = Queries.FindContacts(Query, ByPhone);
        Searched = true;
        SelectedCategory = null;
        SelectedResult = null;
        SelectedChannel = null;
        DispositionComment = string.Empty;
        DispositionMessage = null;
        DispositionSucceeded = false;

        var histories = new Dictionary<string, ClientDispositionHistory>(StringComparer.OrdinalIgnoreCase);
        foreach (var clientId in ClientGroups.Select(group => group.Key))
        {
            histories[clientId] = await Dispositions.GetHistoryAsync(clientId);
        }
        Histories = histories;

        SelectedDispositionClientId = ByPhone && PhoneCandidates.Count == 1
            ? PhoneCandidates[0].ClientId
            : null;
    }

    private void SelectSearchMode(bool byPhone)
    {
        if (ByPhone == byPhone) return;
        ByPhone = byPhone;
        Clear();
    }

    private void Clear()
    {
        Query = string.Empty;
        Results = [];
        Histories = new Dictionary<string, ClientDispositionHistory>(StringComparer.OrdinalIgnoreCase);
        Searched = false;
        SelectedDispositionClientId = null;
        SelectedCategory = null;
        SelectedResult = null;
        SelectedChannel = null;
        DispositionComment = string.Empty;
        DispositionMessage = null;
        DispositionSucceeded = false;
    }

    private async Task OnDispositionClientChangedAsync()
    {
        ResetDispositionResult();
        DispositionMessage = null;
        DispositionSucceeded = false;
        if (!string.IsNullOrWhiteSpace(SelectedDispositionClientId)
            && !Histories.ContainsKey(SelectedDispositionClientId))
        {
            var refreshed = new Dictionary<string, ClientDispositionHistory>(Histories, StringComparer.OrdinalIgnoreCase)
            {
                [SelectedDispositionClientId] = await Dispositions.GetHistoryAsync(SelectedDispositionClientId),
            };
            Histories = refreshed;
        }
    }

    private void ResetDispositionResult() => SelectedResult = null;

    private ClientDispositionHistory HistoryFor(string? clientId) =>
        !string.IsNullOrWhiteSpace(clientId) && Histories.TryGetValue(clientId, out var history)
            ? history
            : ClientDispositionHistory.Empty;

    private async Task SaveDispositionAsync()
    {
        if (!CanSaveDisposition || IsSavingDisposition) return;

        IsSavingDisposition = true;
        DispositionMessage = null;
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var agentId = principal.FindFirst(AgentClaimTypes.AgentId)?.Value
                ?? principal.FindFirst(ClaimTypes.NameIdentifier)?.Value
                ?? string.Empty;
            var agentName = principal.FindFirst(ClaimTypes.Name)?.Value
                ?? principal.Identity?.Name
                ?? string.Empty;
            var history = await Dispositions.RecordAsync(
                SelectedDispositionClientId,
                SearchedPhone,
                SelectedCategory,
                SelectedResult,
                SelectedChannel,
                DispositionComment,
                agentId,
                agentName);
            var refreshed = new Dictionary<string, ClientDispositionHistory>(Histories, StringComparer.OrdinalIgnoreCase)
            {
                [SelectedDispositionClientId!] = history,
            };
            Histories = refreshed;
            DispositionMessage = "Tipificación registrada correctamente.";
            DispositionSucceeded = true;
            SelectedCategory = null;
            SelectedResult = null;
            SelectedChannel = null;
            DispositionComment = string.Empty;
        }
        catch (InvalidOperationException exception)
        {
            DispositionMessage = exception.Message;
            DispositionSucceeded = false;
        }
        finally
        {
            IsSavingDisposition = false;
        }
    }

    private sealed record DispositionClientCandidate(string ClientId, string ClientName);
}
