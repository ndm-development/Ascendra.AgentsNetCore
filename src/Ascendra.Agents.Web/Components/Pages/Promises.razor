@page "/promesas"
@attribute [Authorize]
@implements IDisposable
@inject DashboardQueries Queries
@inject DashboardSession Session
@inject PromiseRegistrationService PromiseRegistrations

@{
    var scope = Queries.FilterByClient(Queries.Scope(), ClientQuery);
    var spreadsheetRows = Queries.FilterPromises(
        scope, null, null, null, null, null, null, null, null, null);
    var pendingRows = RegisteredPromises
        .Select(ToPendingPromise)
        .Where(row => string.IsNullOrWhiteSpace(ClientQuery)
            || row.ClientId.Contains(ClientQuery.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToArray();
    var allPromiseRows = spreadsheetRows.Concat(pendingRows)
        .OrderByDescending(row => row.PromiseDate)
        .ThenByDescending(row => row.CreatedOn)
        .ToArray();
    var availableWeeks = allPromiseRows.Select(DashboardQueries.PromiseWeek)
        .Where(week => week.HasValue)
        .Select(week => week!.Value)
        .Distinct()
        .Order()
        .ToArray();
    if (_week == 0 || !availableWeeks.Contains(_week))
    {
        var currentWeek = System.Globalization.ISOWeek.GetWeekOfYear(DateTime.Today);
        _week = availableWeeks.Where(week => week <= currentWeek).DefaultIfEmpty(availableWeeks.LastOrDefault()).Last();
    }
    var weekRows = allPromiseRows.Where(row => DashboardQueries.PromiseWeek(row) == _week).ToArray();
    var rows = DashboardQueries.FilterPromiseStatusGroup(weekRows, _metricStatus).ToArray();
    var selectedPromiseRows = _selectedPromise is null
        ? rows
        : Queries.PromiseChartDetail(weekRows, _week, _selectedPromise.Day, _selectedPromise.Status);
    var visible = selectedPromiseRows.Take(250).ToArray();
    var summary = Queries.PersonalPromiseSummary(allPromiseRows, _week);
    var selectedStatusLabel = _selectedPromise is null
        ? DashboardQueries.PromiseChartStatusLabel(_metricStatus)
        : DashboardQueries.PromiseChartStatusLabel(_selectedPromise.Status);
    var promiseExportUrl = BuildPromiseExportUrl(_week, ClientQuery, _metricStatus, _selectedPromise);
}

@if (Session.HasFullAccess && IsLoadingRegistrations)
{
    <section class="registered-promises glass-card">
        <p class="eyebrow">REGISTRO ASCENDRA</p>
        <p>Estamos cargando las promesas registradas.</p>
    </section>
}
else if (Session.HasFullAccess && RegisteredPromises.Count > 0)
{
    <section class="registered-promises glass-card">
        <div class="registered-promises__heading">
            <div>
                <p class="eyebrow">REGISTRO ASCENDRA</p>
                <h2>Promesas pendientes del equipo</h2>
                <p>Ya se muestran a los agentes como Esperando pago. Descárgalas para incluirlas en el siguiente cruce.</p>
            </div>
            <div class="collection-export-actions"><span class="registered-promises__count">@RegisteredPromises.Count registros</span><a class="secondary-button collection-export-button" href="/exports/team/promise-registrations" download title="Descargar promesas registradas para el cruce"><span aria-hidden="true">↓</span> Descargar para cruce</a></div>
        </div>
        <div class="table-wrap"><table><thead><tr><th>Id</th><th>Agente</th><th>Cliente único</th><th>Nombre</th><th>Número contactado</th><th>Fecha promesa</th><th>Inicial</th><th>Semanal</th><th>Semanas</th><th>Tipo</th><th>Creación</th><th>Estatus</th></tr></thead><tbody>
            @foreach (var row in RegisteredPromises)
            {
                <tr><td class="registered-promises__id">@row.IdPromise.ToString("D2")</td><td>@row.AgentName</td><td>@row.ClientId</td><td>@row.ClientName</td><td>@row.ClientNumber</td><td class="registered-promises__date">@row.PromiseDate.ToString("dd/MM/yyyy")</td><td>@DashboardQueries.Currency(row.InitialAmount ?? 0m)</td><td>@DashboardQueries.Currency(row.WeeklyAmount ?? 0m)</td><td>@row.NumberOfWeeks</td><td>@row.PromiseType</td><td class="registered-promises__date">@OperationalClock.Format(row.CreatedAt, "dd/MM/yyyy · HH:mm")</td><td><span class="promise-status promise-status--open">Esperando pago</span></td></tr>
            }
        </tbody></table></div>
    </section>
}

@if (Session.HasFullAccess)
{
    @if (!IsLoadingRegistrations && RegisteredPromises.Count == 0)
    {
        <section class="empty-state glass-card">
            <p class="eyebrow">REGISTRO ASCENDRA</p>
            <h1>Aún no hay promesas registradas</h1>
            <p>Las promesas capturadas por los agentes aparecerán aquí automáticamente.</p>
        </section>
    }
}
else
{
<section class="operations-filter-card glass-card agent-collections-filters" aria-label="Filtros de mis promesas">
    <div class="field compact-field">
        <label for="promise-week">Semana</label>
        <select id="promise-week" @bind="_week" @bind:after="ClearSelectedPromise">@foreach (var week in scope.Weeks) { <option value="@week">Semana @week</option> }</select>
    </div>
    <div class="field client-query-field">
        <label for="promise-client">Buscar cliente único</label>
        <input id="promise-client" @bind="ClientQuery" @bind:event="oninput" @bind:after="ClearSelectedPromise" placeholder="Escribe un cliente único" />
    </div>
    <button type="button" class="secondary-button filter-reset" @onclick="Clear">Limpiar filtros</button>
</section>

@if (availableWeeks.Length == 0)
{
    <section class="empty-state glass-card"><h2>Aún no tienes promesas</h2><p>Las promesas que registres aparecerán aquí como Esperando pago.</p></section>
}
else
{
    <section class="compliance-summary glass-card">
        <div class="compliance-summary__intro"><p class="eyebrow">TU CUMPLIMIENTO</p><h1>Mis promesas</h1><p>@summary.Focus</p></div>
        <div class="compliance-score @(ComplianceTone(summary.Rate))" style="--compliance-rate:@CompliancePercentage(summary.Rate)%" role="img" aria-label="@(summary.Rate?.ToString("P0") ?? "Sin datos") de cumplimiento"><div class="compliance-score__inner"><strong>@(summary.Rate?.ToString("P0") ?? "—")</strong><span>cumplimiento</span></div></div>
        <div class="compliance-metrics">
            <button type="button" class="compliance-metric compliance-metric--active @(MetricSelected(ActiveStatusKey) ? "is-selected" : "")" aria-pressed="@MetricSelected(ActiveStatusKey)" title="Filtrar promesas pagadas" @onclick="() => ToggleMetric(ActiveStatusKey)"><strong>@summary.Active</strong><span>Pagada</span></button>
            <button type="button" class="compliance-metric compliance-metric--open @(MetricSelected(OpenStatusKey) ? "is-selected" : "")" aria-pressed="@MetricSelected(OpenStatusKey)" title="Filtrar promesas esperando pago" @onclick="() => ToggleMetric(OpenStatusKey)"><strong>@summary.Open</strong><span>Esperando pago</span></button>
            <button type="button" class="compliance-metric compliance-metric--failed @(MetricSelected(FailedStatusKey) ? "is-selected" : "")" aria-pressed="@MetricSelected(FailedStatusKey)" title="Filtrar promesas sin pago" @onclick="() => ToggleMetric(FailedStatusKey)"><strong>@summary.Failed</strong><span>No pagó</span></button>
            <button type="button" class="compliance-metric compliance-metric--stolen @(MetricSelected(StolenStatusKey) ? "is-selected" : "")" aria-pressed="@MetricSelected(StolenStatusKey)" title="Filtrar por Robada" @onclick="() => ToggleMetric(StolenStatusKey)"><strong>@summary.Stolen</strong><span>Robada</span></button>
            <button type="button" class="compliance-metric compliance-metric--duplicate @(MetricSelected(DuplicateStatusKey) ? "is-selected" : "")" aria-pressed="@MetricSelected(DuplicateStatusKey)" title="Filtrar por Duplicada" @onclick="() => ToggleMetric(DuplicateStatusKey)"><strong>@summary.Duplicate</strong><span>Duplicada</span></button>
            <button type="button" class="compliance-metric @(MetricSelected(EligibleStatusKey) ? "is-selected" : "")" aria-pressed="@MetricSelected(EligibleStatusKey)" title="Filtrar promesas elegibles" @onclick="() => ToggleMetric(EligibleStatusKey)"><strong>@summary.Eligible</strong><span>Elegibles</span></button>
        </div>
    </section>

    <section class="chart-card glass-card personal-chart-card">
        <div class="result-heading collection-chart-heading"><div><h2>Mis promesas por día</h2><p>Esperando pago, pagadas, no pagó, robada y duplicada.</p></div></div>
        <PlotlyChart Id="personal-promises" Model="Queries.PromiseStatusChart(allPromiseRows, _week)" AccessibleLabel="Mis promesas por día" OnPointSelected="SelectPromiseSegment" />
    </section>

    <section class="table-card glass-card agent-promise-card" aria-live="polite">
        <div class="result-heading"><div><p class="eyebrow">@(_selectedPromise is null ? (_metricStatus is null ? "DETALLE" : "FILTRO APLICADO") : "DETALLE DEL SEGMENTO")</p><h2>@(_selectedPromise is not null ? $"Tus promesas {selectedStatusLabel} · {_selectedPromise.Day} · Semana {_week}" : _metricStatus is null ? "Promesas registradas" : $"Promesas {selectedStatusLabel} · Semana {_week}")</h2></div><div class="collection-export-actions"><p>@selectedPromiseRows.Count registros visibles.</p><a class="secondary-button collection-export-button" href="@promiseExportUrl" download title="Descargar las promesas de la selección actual en Excel"><span aria-hidden="true">↓</span> Descargar promesas</a>@if (_selectedPromise is not null || _metricStatus is not null) { <button type="button" class="secondary-button" @onclick="ClearPromiseDetail">Ver todas</button> }</div></div>
        <div class="table-wrap"><table class="promise-table"><thead><tr><th>Id</th><th>Cliente único</th><th>Nombre</th><th>Teléfono</th><th>Fecha promesa</th><th>Monto inicial</th><th>Semanal</th><th>Tipo</th><th>Creación</th><th>Estatus</th></tr></thead><tbody>
            @foreach (var row in visible)
            {
                <tr><td>@row.Id</td><td>@row.ClientId</td><td>@row.ClientName</td><td>@row.ClientNumber</td><td>@(row.PromiseDate?.ToString("dd/MM/yyyy") ?? "—")</td><td>@DashboardQueries.Currency(row.InitialAmount)</td><td>@DashboardQueries.Currency(row.WeeklyAmount)</td><td>@row.Type</td><td>@(row.CreatedOn?.ToString("dd/MM/yyyy") ?? "—")</td><td><span class="promise-status @StatusClass(row.Status)">@DashboardQueries.PromiseStatusLabel(row.Status)</span></td></tr>
            }
        </tbody></table></div>
    </section>
}
}

@code {
    private string ClientQuery { get; set; } = string.Empty;
    private const string ActiveStatusKey = "activa";
    private const string OpenStatusKey = "vigente";
    private const string FailedStatusKey = "incumplida";
    private const string StolenStatusKey = "robada";
    private const string DuplicateStatusKey = "duplicada";
    private const string EligibleStatusKey = "elegible";
    private string? _metricStatus;
    private int _week;
    private PromiseSelection? _selectedPromise;
    private IReadOnlyList<PromiseRegistrationEntry> RegisteredPromises { get; set; } = [];
    private bool IsLoadingRegistrations { get; set; } = true;

    protected override void OnInitialized()
    {
        PromiseRegistrations.Changed += HandlePromiseRegistrationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ReloadRegisteredPromisesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadRegisteredPromisesAsync()
    {
        var user = Session.User;
        RegisteredPromises = Session.HasFullAccess
            ? await PromiseRegistrations.GetPendingForTeamAsync()
            : string.IsNullOrWhiteSpace(user?.Id)
                ? []
                : await PromiseRegistrations.GetPendingForAgentAsync(user.Id);
        IsLoadingRegistrations = false;
    }

    private void HandlePromiseRegistrationChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadRegisteredPromisesAsync();
        StateHasChanged();
    });

    public void Dispose() => PromiseRegistrations.Changed -= HandlePromiseRegistrationChanged;

    private void Clear() { ClientQuery = string.Empty; _metricStatus = null; _selectedPromise = null; }
    private void ClearSelectedPromise() => _selectedPromise = null;
    private void ClearPromiseDetail() { _metricStatus = null; _selectedPromise = null; }
    private bool MetricSelected(string status) => string.Equals(_metricStatus, status, StringComparison.OrdinalIgnoreCase);
    private void ToggleMetric(string status)
    {
        _metricStatus = MetricSelected(status) ? null : status;
        _selectedPromise = null;
    }
    private static int CompliancePercentage(decimal? rate) => rate is decimal value ? (int)Math.Round(value * 100m) : 0;
    private static string BuildPromiseExportUrl(int week, string client, string? metricStatus, PromiseSelection? selection)
    {
        var query = $"week={week}&client={Uri.EscapeDataString(client)}&metric={Uri.EscapeDataString(metricStatus ?? string.Empty)}";
        return selection is null
            ? $"/exports/promises?{query}"
            : $"/exports/promises?{query}&day={Uri.EscapeDataString(selection.Day)}&segment={Uri.EscapeDataString(selection.Status)}";
    }
    private Task SelectPromiseSegment(ChartPointSelection selection)
    {
        var status = DashboardQueries.PromiseChartStatusKey(selection.TraceName);
        _metricStatus = null;
        _selectedPromise = DashboardQueries.Days.Contains(selection.X, StringComparer.OrdinalIgnoreCase)
            && status is not null
            ? new PromiseSelection(selection.X, status)
            : null;
        return InvokeAsync(StateHasChanged);
    }
    private sealed record PromiseSelection(string Day, string Status);
    private static PromiseRecord ToPendingPromise(PromiseRegistrationEntry registration) => new(
        registration.IdPromise.ToString("D2"),
        registration.ClientId,
        registration.ClientName,
        registration.ClientNumber,
        registration.AgentName,
        registration.CreatedByAgentId,
        registration.PromiseDate,
        registration.InitialAmount ?? 0m,
        registration.WeeklyAmount ?? 0m,
        registration.PromiseType,
        registration.NumberOfWeeks,
        DateOnly.FromDateTime(registration.CreatedAt.LocalDateTime),
        "Vigente",
        registration.IdPromise);
    private static string ComplianceTone(decimal? rate) => rate switch { >= .60m => "compliance-score--positive", >= .45m => "compliance-score--caution", < .45m => "compliance-score--attention", _ => string.Empty };
    private static string StatusClass(string status) => TextNormalization.Normalize(status) switch { "robada" => "promise-status--stolen", "duplicada" => "promise-status--duplicate", "incumplida" => "promise-status--failed", "activa" or "cumplida" or "cumplido" => "promise-status--paid", "vigente" => "promise-status--open", _ => "promise-status--neutral" };
}
