@page "/registrar-promesa"
@attribute [Authorize]
@inject DashboardSession Session
@inject PromiseRegistrationService PromiseRegistrations

@if (Session.HasFullAccess)
{
    <section class="empty-state glass-card">
        <p class="eyebrow">OPERACIÓN DE EQUIPO</p>
        <h1>El registro de promesas corresponde a los agentes</h1>
        <p>Puedes consultar las promesas registradas desde la sección Promesas.</p>
        <a class="primary-button" href="/promesas">Ver promesas</a>
    </section>
}
else
{
    <section class="promise-registration glass-card" aria-label="Registrar promesa">
        <div class="promise-registration__heading">
            <div>
                <p class="eyebrow">REGISTRO DE PROMESA</p>
                <h1>Registrar promesa</h1>
            </div>
            <span class="promise-registration__agent">@Session.User?.DisplayName</span>
        </div>

        @if (Saved && SavedPromise is { } savedPromise)
        {
            <div class="promise-registration__success" role="status" aria-live="polite">
                <span class="promise-registration__success-icon" aria-hidden="true">✓</span>
                <div>
                    <p>PROMESA GUARDADA</p>
                    <strong>Folio @savedPromise.IdPromise:D2 · @savedPromise.ClientName</strong>
                    <span>@savedPromise.ClientId · @savedPromise.PromiseDate.ToString("dd/MM/yyyy") · @savedPromise.ClientNumber</span>
                </div>
                <span class="promise-registration__success-state">Registro confirmado</span>
            </div>
        }

        <div class="promise-registration__flow">
            <div class="promise-registration__workbench" role="group" aria-label="Datos de la promesa">
                <section class="promise-stage">
                    <div class="promise-stage__heading">
                        <span>01</span>
                        <h2>Cliente</h2>
                    </div>
                    <div class="promise-stage__fields promise-stage__fields--client">
                        <div class="field">
                            <label for="promise-client-id">Cliente único</label>
                            <div class="promise-registration__client-input">
                                <input id="promise-client-id" @ref="ClientIdInput" @bind="ClientId" @bind:event="oninput" @bind:after="ClearClientLookupWhenChanged" @onkeydown="LookupOnEnterAsync" maxlength="100" autocomplete="off" placeholder="CLIENTE_UNICO" />
                                <button type="button" class="promise-registration__client-search" @onclick="LookupClientAsync" disabled="@(IsLookingUp || string.IsNullOrWhiteSpace(ClientId))" aria-label="Buscar cliente único" title="Buscar cliente">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
                                </button>
                            </div>
                        </div>
                        <div class="field">
                            <span class="promise-registration__field-label">Nombre del cliente</span>
                            <div class="promise-registration__client-name @(Lookup is { Exists: true } ? "promise-registration__client-name--confirmed" : string.Empty)" aria-label="Nombre del cliente" aria-live="polite">
                                @if (IsLookingUp)
                                {
                                    <span class="promise-registration__client-name-loading">Validando cliente…</span>
                                }
                                else if (Lookup is { Exists: true })
                                {
                                    <span class="promise-registration__client-name-check" aria-hidden="true">✓</span>
                                    <strong>@ClientName</strong>
                                }
                                else
                                {
                                    <span>Se completa al validar el cliente</span>
                                }
                            </div>
                        </div>
                    </div>
                </section>

                <section class="promise-stage promise-stage--phone @(Lookup is { Exists: true } && !HasValidPhoneNumber ? "promise-stage--required" : string.Empty)">
                    <div class="promise-stage__heading">
                        <span>02</span>
                        <h2>Teléfono contactado</h2>
                    </div>
                    <div class="field promise-stage__phone-field">
                        <label for="promise-contact-number">Número contactado <em>Obligatorio</em></label>
                        @if (Lookup is { Exists: true } && Lookup.ContactNumbers.Count > 0 && !IsUsingCustomPhoneNumber)
                        {
                            <select id="promise-contact-number" @ref="ClientNumberSelect" @bind="SelectedPhoneNumber" autocomplete="tel">
                                <option value="">Selecciona un número</option>
                                @foreach (var phone in Lookup.ContactNumbers)
                                {
                                    <option value="@phone.Number">@phone.Number · @phone.Source</option>
                                }
                                <option value="@CustomPhoneOption">Otro número…</option>
                            </select>
                        }
                        else
                        {
                            <div class="promise-registration__phone-input">
                                <input id="promise-contact-number" @ref="ClientNumberInput" @bind="ClientNumber" @bind:event="oninput" inputmode="numeric" maxlength="20" autocomplete="tel" disabled="@(Lookup is not { Exists: true })" placeholder="@(Lookup is { Exists: true } ? "Escribe 10 dígitos" : "Valida primero el cliente")" />
                                @if (Lookup is { Exists: true } && Lookup.ContactNumbers.Count > 0)
                                {
                                    <button type="button" class="promise-registration__phone-picker" @onclick="ShowKnownPhoneNumbers" aria-label="Ver números asociados" title="Ver números asociados">
                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m7 9 5 5 5-5" /></svg>
                                    </button>
                                }
                            </div>
                        }
                        <div class="promise-stage__phone-status @(HasValidPhoneNumber ? "promise-stage__phone-status--complete" : string.Empty)" aria-live="polite">
                            <span aria-hidden="true">@(HasValidPhoneNumber ? "✓" : "!")</span>
                            <strong>@PhoneStatus</strong>
                        </div>
                    </div>
                </section>

                <section class="promise-stage">
                    <div class="promise-stage__heading">
                        <span>03</span>
                        <h2>Datos de la promesa</h2>
                    </div>
                    <div class="promise-stage__fields promise-stage__fields--details">
                        <div class="field">
                            <label for="promise-date">Fecha de promesa</label>
                            <input id="promise-date" type="date" @bind="PromiseDate" />
                        </div>
                        <div class="field">
                            <label for="promise-initial-amount">Monto inicial</label>
                            <input id="promise-initial-amount" type="number" @bind="InitialAmount" min="0" step="0.01" inputmode="decimal" placeholder="$0.00" />
                        </div>
                        <div class="field">
                            <label for="promise-weekly-amount">Monto semanal</label>
                            <input id="promise-weekly-amount" type="number" @bind="WeeklyAmount" min="0" step="0.01" inputmode="decimal" placeholder="$0.00" />
                        </div>
                        <div class="field">
                            <label for="promise-weeks">Número de semanas</label>
                            <input id="promise-weeks" type="number" @bind="NumberOfWeeks" min="0" max="255" step="1" inputmode="numeric" />
                        </div>
                        <div class="field promise-stage__type-field">
                            <label for="promise-type">Tipo de promesa</label>
                            <select id="promise-type" @bind="PromiseType">
                                <option value="">Selecciona un tipo</option>
                                @foreach (var type in PromiseRegistrations.Types)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="promise-registration__submit-panel">
                        <div>
                            <strong>@SaveHint</strong>
                        </div>
                        <button type="button" class="primary-button" @onclick="SaveAsync" disabled="@(!CanSave)">
                            @SaveButtonLabel
                        </button>
                    </div>
                </section>
            </div>
        </div>

        @if (Lookup is { Exists: false } && !string.IsNullOrWhiteSpace(ClientId))
        {
            <p class="lookup-notice lookup-notice--error" role="status">No encontramos ese CLIENTE_UNICO en la cartera vigente.</p>
        }
        else if (Lookup?.ActivePromise is { } activePromise)
        {
            <p class="lookup-notice lookup-notice--attention" role="status">Este cliente ya tiene una promesa vigente (@activePromise.PromiseId) para el @activePromise.PromiseDate.ToString("dd/MM/yyyy").</p>
        }
        else if (!string.IsNullOrWhiteSpace(Notice) && !Saved)
        {
            <p class="lookup-notice @(Saved ? "lookup-notice--success" : "lookup-notice--error")" role="status">@Notice</p>
        }
    </section>

    <section class="promise-registration__whatsapp" aria-label="Mensajes de WhatsApp">
        <WhatsApp />
    </section>
}

@code {
    private string ClientId { get; set; } = string.Empty;
    private string ClientNumber { get; set; } = string.Empty;
    private DateOnly? PromiseDate { get; set; } = OperationalClock.Date(DateTimeOffset.UtcNow);
    private decimal? InitialAmount { get; set; }
    private decimal? WeeklyAmount { get; set; }
    private int NumberOfWeeks { get; set; } = 1;
    private string PromiseType { get; set; } = string.Empty;
    private PromiseClientLookup? Lookup { get; set; }
    private PromiseRegistrationEntry? SavedPromise { get; set; }
    private string? Notice { get; set; }
    private bool Saved { get; set; }
    private bool IsSaving { get; set; }
    private bool IsLookingUp { get; set; }
    private bool IsUsingCustomPhoneNumber { get; set; }
    private ElementReference ClientIdInput;
    private ElementReference ClientNumberInput;
    private ElementReference ClientNumberSelect;
    private bool FocusClientId { get; set; }
    private bool FocusClientNumber { get; set; }
    private bool FocusClientNumberSelect { get; set; }

    private const string CustomPhoneOption = "__custom_phone__";

    private string ClientName => Lookup is { Exists: true } ? Lookup.ClientName : string.Empty;
    private bool HasValidPhoneNumber => Lookup is { Exists: true }
        && TextNormalization.Phone(ClientNumber).Length == 10;
    private string SaveButtonLabel => IsSaving ? "Guardando…"
        : Lookup is not { Exists: true } ? "Valida el cliente"
        : Lookup.ActivePromise is not null ? "Promesa vigente"
        : !HasValidPhoneNumber ? "Selecciona el teléfono"
        : !HasValidPromiseData ? "Completa los datos"
        : "Registrar promesa";
    private string PhoneStatus => Lookup is not { Exists: true }
        ? "Valida el cliente primero"
        : HasValidPhoneNumber
            ? "Teléfono confirmado"
            : "Selecciona un teléfono";
    private string SaveHint => Lookup is not { Exists: true }
        ? "Valida el cliente"
        : Lookup.ActivePromise is not null
            ? "Promesa vigente"
            : !HasValidPhoneNumber
                ? "Selecciona el teléfono"
                : !HasValidPromiseData
                    ? "Completa los datos"
                    : "Listo para guardar";
    private bool HasValidPromiseData => Lookup is { Exists: true, ActivePromise: null }
        && HasValidPhoneNumber
        && PromiseDate is not null
        && InitialAmount is not null && InitialAmount >= 0
        && WeeklyAmount is not null && WeeklyAmount >= 0
        && NumberOfWeeks is >= 0 and <= 255
        && PromiseRegistrations.Types.Contains(PromiseType, StringComparer.OrdinalIgnoreCase);
    private bool CanSave => !IsSaving && HasValidPromiseData;
    private string SelectedPhoneNumber
    {
        get => IsUsingCustomPhoneNumber ? CustomPhoneOption : ClientNumber;
        set
        {
            if (value == CustomPhoneOption)
            {
                ClientNumber = string.Empty;
                IsUsingCustomPhoneNumber = true;
                FocusClientNumber = true;
                return;
            }

            ClientNumber = value;
            IsUsingCustomPhoneNumber = false;
        }
    }

    private async Task LookupClientAsync()
    {
        if (IsLookingUp || string.IsNullOrWhiteSpace(ClientId)) return;

        var previousClientId = Lookup?.ClientId;
        Notice = null;
        Saved = false;
        SavedPromise = null;
        IsLookingUp = true;
        try
        {
            Lookup = await PromiseRegistrations.LookupClientAsync(ClientId);
            if (!string.Equals(previousClientId, Lookup.ClientId, StringComparison.OrdinalIgnoreCase))
            {
                ClientNumber = string.Empty;
                IsUsingCustomPhoneNumber = false;
            }
            FocusClientNumber = Lookup.Exists && Lookup.ActivePromise is null
                && (Lookup.ContactNumbers.Count == 0 || IsUsingCustomPhoneNumber);
            FocusClientNumberSelect = Lookup.Exists && Lookup.ActivePromise is null
                && Lookup.ContactNumbers.Count > 0 && !IsUsingCustomPhoneNumber;
            FocusClientId = !Lookup.Exists;
        }
        catch (InvalidOperationException exception)
        {
            Notice = exception.Message;
        }
        finally
        {
            IsLookingUp = false;
        }
    }

    private Task LookupOnEnterAsync(KeyboardEventArgs arguments) =>
        arguments.Key.Equals("Enter", StringComparison.Ordinal)
            ? LookupClientAsync()
            : Task.CompletedTask;

    private void ClearClientLookupWhenChanged()
    {
        if (Lookup is null || string.Equals(Lookup.ClientId, ClientId.Trim(), StringComparison.OrdinalIgnoreCase)) return;
        Lookup = null;
        ClientNumber = string.Empty;
        IsUsingCustomPhoneNumber = false;
        Notice = null;
        Saved = false;
        SavedPromise = null;
    }

    private void ShowKnownPhoneNumbers()
    {
        ClientNumber = string.Empty;
        IsUsingCustomPhoneNumber = false;
        FocusClientNumberSelect = true;
    }

    private async Task SaveAsync()
    {
        if (IsSaving) return;

        IsSaving = true;
        Notice = null;
        Saved = false;
        try
        {
            // Se valida otra vez al guardar: la cartera o una promesa vigente
            // pueden haber cambiado mientras el formulario estaba abierto.
            Lookup = await PromiseRegistrations.LookupClientAsync(ClientId);
            if (!HasValidPromiseData)
            {
                Notice = "Revisa los datos requeridos antes de registrar la promesa.";
                return;
            }

            var entry = await PromiseRegistrations.RegisterAsync(
                ClientId,
                ClientNumber,
                PromiseDate,
                InitialAmount,
                WeeklyAmount,
                NumberOfWeeks,
                PromiseType,
                Session.User?.DisplayName,
                Session.User?.Id);
            SavedPromise = entry;
            Saved = true;
            ClearForm();
            FocusClientId = true;
        }
        catch (InvalidOperationException exception)
        {
            Notice = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ClearForm()
    {
        ClientId = string.Empty;
        ClientNumber = string.Empty;
        IsUsingCustomPhoneNumber = false;
        PromiseDate = OperationalClock.Date(DateTimeOffset.UtcNow);
        InitialAmount = null;
        WeeklyAmount = null;
        NumberOfWeeks = 1;
        PromiseType = string.Empty;
        Lookup = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusClientNumber)
        {
            FocusClientNumber = false;
            await ClientNumberInput.FocusAsync();
        }
        else if (FocusClientNumberSelect)
        {
            FocusClientNumberSelect = false;
            await ClientNumberSelect.FocusAsync();
        }
        else if (FocusClientId)
        {
            FocusClientId = false;
            await ClientIdInput.FocusAsync();
        }
    }
}
