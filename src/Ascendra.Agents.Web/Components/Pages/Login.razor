@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout
@inject ExcelSnapshotStore SnapshotStore
@inject NavigationManager Navigation

<section class="login-stack" aria-labelledby="ascendra-title">
    <header class="login-brand">
        <div class="login-mark" aria-hidden="true"><span>A</span></div>
        <h1 id="ascendra-title">Ascendra</h1>
        <p class="login-workspace">Xolo · Agentes</p>
    </header>
    <div class="login-access-card">
        <div class="login-access-card__header" aria-hidden="true">
            <span class="login-access-card__signal"><i></i> Acceso seguro</span>
            <span>ASCENDRA</span>
        </div>
        <form method="post" action="/account/login" class="login-form" aria-label="Acceso a Agentes">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            @if (HasError) { <div class="form-alert form-alert--error" role="alert">Usuario o contraseña no válidos.</div> }
            @if (SessionExpired) { <div class="form-alert" role="status">Por seguridad, tu sesión se cerró después de dos horas sin actividad.</div> }
            @if (IsStarting || !SnapshotStore.Health.IsReady) { <div class="form-alert" role="status">Estamos actualizando el corte de trabajo. Tu acceso estará listo en un momento.</div> }
            <label class="login-field" for="username">
                <span>Usuario</span>
                <input id="username" name="username" placeholder="Ingresa tu usuario" autocomplete="username" required autofocus />
            </label>
            <label class="login-field" for="password">
                <span>Contraseña</span>
                <input id="password" name="password" type="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" required />
            </label>
            <button type="submit" class="primary-button"><span>Continuar</span><span class="login-button-arrow" aria-hidden="true">→</span></button>
        </form>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "timeout")] public string? Timeout { get; set; }
    [SupplyParameterFromQuery(Name = "starting")] public string? Starting { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? RequestedReturnUrl { get; set; }
    private bool HasError => Error == "1";
    private bool SessionExpired => Timeout == "1";
    private bool IsStarting => Starting == "1";
    private string ReturnUrl => !string.IsNullOrWhiteSpace(RequestedReturnUrl) && RequestedReturnUrl.StartsWith('/') && !RequestedReturnUrl.StartsWith("//")
        ? RequestedReturnUrl
        : "/referencias";
}
