@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject OperationalAssetUrls AssetUrls
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@AssetUrls.Url("ascendra-mark.svg")" />
    <link rel="apple-touch-icon" href="@AssetUrls.Url("xolo-wolf.png")" />
    <link rel="stylesheet" href="@AssetUrls.WebUrl("css/app.css")" />
    <link rel="stylesheet" href="Ascendra.Agents.Web.styles.css" />
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="components-reconnect-modal" aria-live="assertive" aria-atomic="true">
        <div class="reconnect-card" role="status">
            <span class="reconnect-card__pulse" aria-hidden="true"></span>
            <p class="eyebrow">CONEXIÓN SEGURA</p>
            <h2>Actualizando Ascendra</h2>
            <p id="components-reconnect-message">Estamos recuperando la conexión.</p>
            <small>Tu sesión se conservará y volveremos a conectarte automáticamente.</small>
        </div>
    </div>
    <script src="@AssetUrls.WebUrl("js/charts.js")"></script>
    <script src="@AssetUrls.WebUrl("js/session.js")"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>window.ascendraReconnect.start();</script>
</body>
</html>
