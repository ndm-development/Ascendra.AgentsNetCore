@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject OperationalAssetUrls AssetUrls
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@AssetUrls.WebUrl("css/app.css")" />
    <link rel="preconnect" href="https://cdn.plot.ly" />
    <HeadOutlet />
</head>
<body>
