{
  "Data": {
    "InputPath": "data/input",
    "GeneratedPath": "data/generated",
    "RefreshSeconds": 45
  },
  "Security": {
    "CredentialsEnvironmentVariable": "ASCENDRA_AGENT_CREDENTIALS_JSON",
    "AllowLocalPreview": false,
    "DataProtectionPath": ""
  },
  "Chat": {
    "StoragePath": "/var/data/ascendra-chat.json",
    "AttachmentStoragePath": "/var/data/ascendra-chat-attachments",
    "RetentionDays": 7
  },
  "CallDispositions": {
    "StoragePath": "/var/data/ascendra-call-dispositions",
    "HistoryDisplayLimit": 80
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
