<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>Ascendra.Agents.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
    <PackageReference Include="Norgerman.Cryptography.Scrypt" Version="2.5.0" />
  </ItemGroup>

  <!-- La carpeta raíz /assets es la única fuente publicada de fondos y marca.
       Estas copias históricas no deben competir con ella durante un despliegue. -->
  <ItemGroup>
    <Content Remove="wwwroot/assets/**" />
    <Content Include="../../assets/**">
      <Link>assets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
